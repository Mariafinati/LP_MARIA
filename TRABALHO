        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# Função para carregar arquivos CSV\n",
        "def carregar_dados(caminho):\n",
        "    try:\n",
        "        dados = pd.read_csv(caminho, delimiter=',')  # Ajuste o delimitador, se necessário\n",
        "        dados.columns = dados.columns.str.strip()  # Remover espaços extras nos nomes das colunas\n",
        "        return dados\n",
        "    except FileNotFoundError:\n",
        "        print(f\"\\nErro: O arquivo '{caminho}' não foi encontrado. Verifique o caminho.\")\n",
        "        return None\n",
        "    except pd.errors.ParserError:\n",
        "        print(f\"\\nErro: O arquivo '{caminho}' não é um CSV válido ou está mal formatado.\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"\\nOcorreu um erro ao processar o arquivo '{caminho}': {e}\")\n",
        "        return None\n",
        "\n",
        "# Função para calcular porcentagem de peças faltando\n",
        "def calcular_porcentagem(dados):\n",
        "    if 'Rua' in dados.columns and 'End Vazios' in dados.columns and 'Unidades' in dados.columns:\n",
        "        dados['Porcentagem_Faltante'] = (dados['End Vazios'] / dados['Unidades']) * 100\n",
        "        return dados\n",
        "    else:\n",
        "        print(\"\\nErro: As colunas 'Rua', 'End Vazios' ou 'Unidades' não foram encontradas no arquivo.\")\n",
        "        return None\n",
        "\n",
        "# Função para exibir as ruas e suas porcentagens\n",
        "def exibir_ruas(dados):\n",
        "    print(\"\\nLista de ruas e suas porcentagens de peças faltando:\")\n",
        "    for index, row in dados.iterrows():\n",
        "        print(f\"- Rua {row['Rua']}: {row['Porcentagem_Faltante']:.2f}% de peças faltando.\")\n",
        "\n",
        "# Função para pesquisar por uma rua e exibir os end vazios\n",
        "def pesquisar_rua_end_vazios(dados):\n",
        "    rua_pesquisada = input(\"\\nDigite o nome da rua para pesquisar (ou parte do nome): \").strip()\n",
        "    dados['Rua'] = dados['Rua'].astype(str)  # Garantir que a coluna 'Rua' seja tratada como string\n",
        "    resultado = dados[dados['Rua'].str.contains(rua_pesquisada, case=False, na=False)]\n",
        "\n",
        "    if resultado.empty:\n",
        "        print(f\"\\nNenhuma rua encontrada com o nome '{rua_pesquisada}'. Tente novamente com um nome diferente.\")\n",
        "    else:\n",
        "        print(\"\\nResultado da pesquisa:\")\n",
        "        print(resultado[['Rua', 'End Vazios']])\n",
        "\n",
        "        # Gerar o relatório com os dados pesquisados\n",
        "        gerar_relatorio_pesquisa(resultado)\n",
        "\n",
        "# Função para gerar relatório com os dados pesquisados\n",
        "def gerar_relatorio_pesquisa(dados_pesquisados):\n",
        "    try:\n",
        "        # Salvar o relatório de dados pesquisados em CSV\n",
        "        dados_pesquisados.to_csv(\"relatorio_pesquisa.csv\", index=False)\n",
        "        print(\"\\nRelatório gerado com sucesso: relatorio_pesquisa.csv\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"\\nErro ao gerar o relatório de pesquisa: {e}\")\n",
        "\n",
        "# Função para exibir todos os dados\n",
        "def exibir_dados_completos(dados):\n",
        "    print(\"\\nExibindo todos os dados carregados:\")\n",
        "    print(dados)\n",
        "\n",
        "# Função para gerar relatório e gráfico\n",
        "def gerar_relatorio_e_grafico(dados):\n",
        "    try:\n",
        "        # Tratar dados: remover linhas com valores nulos ou negativos de 'Porcentagem_Faltante'\n",
        "        dados_validos = dados.dropna(subset=['Porcentagem_Faltante'])\n",
        "        dados_validos = dados_validos[dados_validos['Porcentagem_Faltante'] >= 0]\n",
        "\n",
        "        # Ordenar os dados pela porcentagem de peças faltando, de forma decrescente\n",
        "        dados_validos = dados_validos.sort_values(by='Porcentagem_Faltante', ascending=False)\n",
        "\n",
        "        # Salvar o relatório completo em CSV\n",
        "        dados_validos.to_csv(\"relatorio_completo.csv\", index=False)\n",
        "        print(\"\\nRelatório completo gerado com sucesso: relatorio_completo.csv\")\n",
        "\n",
        "        # Gerar gráfico de barras para porcentagem de peças faltando por rua\n",
        "        plt.figure(figsize=(12, 6))\n",
        "        plt.bar(dados_validos['Rua'], dados_validos['Porcentagem_Faltante'], color=plt.cm.viridis(dados_validos['Porcentagem_Faltante'] / max(dados_validos['Porcentagem_Faltante'])))\n",
        "        plt.xlabel('Rua')\n",
        "        plt.ylabel('Porcentagem de Peças Faltando')\n",
        "        plt.title('Porcentagem de Peças Faltando por Rua')\n",
        "        plt.xticks(rotation=90)  # Rotaciona os nomes das ruas para melhor visualização\n",
        "        plt.tight_layout()\n",
        "\n",
        "        # Adicionar linha de grade\n",
        "        plt.grid(True, axis='y', linestyle='--', alpha=0.7)\n",
        "\n",
        "        # Exibir o gráfico\n",
        "        plt.show()\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"\\nErro ao gerar o relatório ou o gráfico: {e}\")\n",
        "\n",
        "# Função principal do menu interativo\n",
        "def menu():\n",
        "    print(\"\\n\" + \"=\"*50)\n",
        "    print(\"Bem-vindo ao Sistema de Análise de Dados de Ruas e Peças Faltando!\")\n",
        "    print(\"=\"*50)\n",
        "    print(\"\\nPor favor, faça o upload de dois arquivos CSV para continuar.\")\n",
        "\n",
        "    # Upload dos arquivos\n",
        "    uploaded = files.upload()\n",
        "\n",
        "    # Identificar os arquivos carregados\n",
        "    arquivos = list(uploaded.keys())\n",
        "    if len(arquivos) < 2:\n",
        "        print(\"\\nErro: Por favor, carregue dois arquivos CSV.\")\n",
        "        return\n",
        "\n",
        "    # Carregar os dados dos dois arquivos\n",
        "    dados_ruas = carregar_dados(arquivos[0])\n",
        "    dados_zonas = carregar_dados(arquivos[1])\n",
        "\n",
        "    if dados_ruas is None or dados_zonas is None:\n",
        "        return\n",
        "\n",
        "    # Calcular porcentagens no arquivo de ruas\n",
        "    dados_ruas = calcular_porcentagem(dados_ruas)\n",
        "    if dados_ruas is None:\n",
        "        return\n",
        "\n",
        "    while True:\n",
        "        print(\"\\n\" + \"=\"*50)\n",
        "        print(\"Menu de Opções:\")\n",
        "        print(\"1. Exibir todas as ruas e suas porcentagens de peças faltando\")\n",
        "        print(\"2. Pesquisar por uma rua e exibir as peças faltando ('End Vazios')\")\n",
        "        print(\"3. Exibir a rua com a menor porcentagem de peças faltando\")\n",
        "        print(\"4. Exibir todos os dados carregados\")\n",
        "        print(\"5. Gerar relatório completo e gráfico\")\n",
        "        print(\"6. Sair\")\n",
        "        print(\"=\"*50)\n",
        "\n",
        "        opcao = input(\"\\nEscolha uma opção (1-6): \").strip()\n",
        "\n",
        "        if opcao == '1':\n",
        "            exibir_ruas(dados_ruas)\n",
        "        elif opcao == '2':\n",
        "            pesquisar_rua_end_vazios(dados_ruas)\n",
        "        elif opcao == '3':\n",
        "            min_porcentagem = dados_ruas.loc[dados_ruas['Porcentagem_Faltante'].idxmin()]\n",
        "            print(f\"\\nA rua com a menor porcentagem de peças faltando é {min_porcentagem['Rua']} com {min_porcentagem['Porcentagem_Faltante']:.2f}%.\")\n",
        "        elif opcao == '4':\n",
